# Copy to `.env` and fill in. Never commit `.env`.

# ── API server ────────────────────────────────────────────────
PORT=3000

# ── LLM providers ─────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Firebase (web client) ─────────────────────────────────────
# Public web-app config (`firebase apps:sdkconfig web`). The api serves it to the
# browser at GET /api/config; it is public by design, not a secret.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Firebase Admin (API server) ───────────────────────────────
# Server-side only. Defaults to <FIREBASE_PROJECT_ID>.firebasestorage.app.
FIREBASE_STORAGE_BUCKET=
# Either point at a service-account JSON file…
GOOGLE_APPLICATION_CREDENTIALS=
# …or provide the service-account fields directly (keep the \n escapes in the key).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Firebase emulators (local dev) ────────────────────────────
# Set while `firebase emulators:start` is running so the Admin SDK talks to the
# emulators instead of the live project. Leave empty to use the live project.
# Values: 127.0.0.1:8080 / 127.0.0.1:9099 / 127.0.0.1:9199
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=

# ── Per-user rate limits (optional; defaults shown) ───────────
# RATE_LIMIT_CHAT_PER_MINUTE=10  RATE_LIMIT_CHAT_PER_DAY=200
# RATE_LIMIT_UPLOADS_PER_HOUR=10 RATE_LIMIT_UPLOADS_PER_DAY=30
RATE_LIMIT_CHAT_PER_MINUTE=
RATE_LIMIT_CHAT_PER_DAY=
RATE_LIMIT_UPLOADS_PER_HOUR=
RATE_LIMIT_UPLOADS_PER_DAY=
