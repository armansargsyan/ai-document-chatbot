# Copy to `.env` and fill in. Never commit `.env`.

# ── API server ────────────────────────────────────────────────
PORT=3000

# ── LLM providers ─────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Firebase (web client) ─────────────────────────────────────
# Public web-app config from Firebase console → Project settings → Your apps.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin (API server) ───────────────────────────────
# Either point at a service-account JSON file…
GOOGLE_APPLICATION_CREDENTIALS=
# …or provide the service-account fields directly (keep the \n escapes in the key).
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
